// The source of wrangler.jsonc, which tooling/wire renders from it: from
// wiring.fixture.json for local work (`pnpm run wire:fixture`, committed as
// that render), and on every Orun lane from the wiring document the
// `cloudflare-hyperdrive` Terraform root lease-publishes
// (WIRING_CLOUDFLARE_HYPERDRIVE_<ENV>) — dev, which no root applies to, from
// the fixture (component.yaml's buildCommand). Edit this file, never
// wrangler.jsonc. The workers-assets composition deploys one environment per
// job with no wrangler `--env`, so `__ENV__` names the environment this is
// rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-forge-api",
  // The custom entry: the fetch handler @opennextjs/cloudflare generates plus
  // the `scheduled` handler the Cron Trigger calls (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers Logs: where upstream's Sentry and BetterStack logging went
  // (@repo/observability).
  "observability": { "enabled": true },
  // Upstream's vercel.json cron, daily at midnight UTC: /cron/keep-alive
  // writes and deletes a row, so a Supabase free project (which pauses after
  // a week idle, as Neon's did) stays awake. One trigger per Worker — two for
  // stage and prod — fits Workers Free's five per account.
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  // The Supabase project's Postgres, fronted by Hyperdrive (@repo/database).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "@@wiring(cloudflare-hyperdrive/__ENV__:hyperdrive_id)@@",
      "localConnectionString": "postgres://postgres:postgres@localhost:54322/postgres"
    }
  ]
  // Secrets are never vars. Stripe's and Clerk's webhook secrets, Stripe's
  // key, PostHog, Sentry and BetterStack are optional: Orun secrets the
  // deploy hands to this Worker (component.yaml). Locally, .dev.vars.
}
