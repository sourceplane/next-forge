# The origins the three Workers link to each other by, inlined at build time
# (NEXT_PUBLIC_). These are stage's workers.dev URLs, for a local
# `pnpm build`; every Orun lane builds with its own environment's
# (component.yaml's buildCommand), which wins over this file.
NEXT_PUBLIC_APP_URL=https://next-forge-app-stage.your-workers-subdomain.workers.dev
NEXT_PUBLIC_WEB_URL=https://next-forge-web-stage.your-workers-subdomain.workers.dev
NEXT_PUBLIC_API_URL=https://next-forge-api-stage.your-workers-subdomain.workers.dev
# This app's own origin: its metadata's base URL.
NEXT_PUBLIC_SITE_URL=https://next-forge-app-stage.your-workers-subdomain.workers.dev
