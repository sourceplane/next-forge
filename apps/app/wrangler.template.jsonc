// The source of wrangler.jsonc, which tooling/wire renders from it: from
// wiring.fixture.json for local work (`pnpm run wire:fixture`, committed as
// that render), and on every Orun lane from the wiring documents the
// `cloudflare-hyperdrive` and `cloudflare-r2` Terraform roots lease-publish
// (WIRING_CLOUDFLARE_HYPERDRIVE_<ENV>, WIRING_CLOUDFLARE_R2_<ENV>) — dev,
// which no root applies to, from the fixture (component.yaml's buildCommand).
// Edit this file, never wrangler.jsonc. The workers-assets composition
// deploys one environment per job with no wrangler `--env`, so `__ENV__`
// names the environment this is rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-forge-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers Logs: where upstream's Sentry and BetterStack logging went
  // (@repo/observability).
  "observability": { "enabled": true },
  // The Supabase project's Postgres, fronted by Hyperdrive: @repo/database
  // opens a postgres.js client on env.HYPERDRIVE.connectionString per call
  // (upstream: Prisma on Neon). Locally — `wrangler dev`, `next dev` — the
  // binding points at the Supabase CLI's database (`supabase start`).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "@@wiring(cloudflare-hyperdrive/__ENV__:hyperdrive_id)@@",
      "localConnectionString": "postgres://postgres:postgres@localhost:54322/postgres"
    }
  ],
  // @repo/storage — Vercel Blob upstream.
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "@@wiring(cloudflare-r2/__ENV__:r2_bucket_name)@@"
    }
  ],
  // @repo/ai's default models: Workers AI, no key.
  "ai": { "binding": "AI" }
  // Secrets are never vars. Every SaaS key (Clerk, Liveblocks, Knock, Svix,
  // PostHog, Sentry, BetterStack, OpenAI) is optional: an Orun secret
  // per environment that the deploy hands to this Worker as a Worker secret
  // (component.yaml). Locally they go in .dev.vars.
}
